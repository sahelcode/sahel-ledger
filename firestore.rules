rules_version = '2';

// Sahel Ledger security rules.
//
// Model (mirrors lib/domain/access/access.dart):
//   households/{hid}                    household; ownerUid
//   households/{hid}/members/{uid}      role: owner | admin | member
//                                       perms: delegated permissions (admins)
//                                       fundIds / personIds: what a member may see
//   households/{hid}/<data>/{id}        every document carries readerUids
//   invites/{code}                      single-use, email-bound invitations
//
// Reads: owners and admins with `readAll` read everything in their
// household; everyone else only documents whose readerUids contains their
// uid (queries must filter on `readerUids array-contains uid`).
// Writes: only active members with the matching permission. Posted ledger
// entries can never be deleted and their financial content can never change.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function householdPath(hid) {
      return /databases/$(database)/documents/households/$(hid);
    }

    function memberPath(hid) {
      return /databases/$(database)/documents/households/$(hid)/members/$(request.auth.uid);
    }

    function member(hid) {
      return get(memberPath(hid)).data;
    }

    function isMember(hid) {
      return signedIn() && exists(memberPath(hid)) && member(hid).status == 'active';
    }

    function isOwner(hid) {
      return isMember(hid) && member(hid).role == 'owner';
    }

    function can(hid, perm) {
      return isMember(hid) && (member(hid).role == 'owner'
        || (member(hid).role == 'admin' && perm in member(hid).perms));
    }

    function readsAll(hid) {
      return can(hid, 'readAll');
    }

    function canRead(hid) {
      return isMember(hid)
        && (readsAll(hid) || request.auth.uid in resource.data.readerUids);
    }

    function stampedNow() {
      return request.resource.data.updatedAtServer == request.time;
    }

    function hasReaders() {
      return request.resource.data.readerUids is list
        && request.resource.data.readerUids.size() <= 50;
    }

    // ------------------------------------------------------------ households

    match /households/{hid} {
      allow read: if isMember(hid);

      // Created together with the creator's owner membership (batched).
      allow create: if signedIn()
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.keys().hasOnly(['name', 'ownerUid', 'createdAt'])
        && request.resource.data.name is string
        && request.resource.data.name.size() <= 120
        && getAfter(memberPath(hid)).data.role == 'owner';

      allow update: if isOwner(hid)
        && request.resource.data.ownerUid == resource.data.ownerUid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name']);

      allow delete: if false;

      // -------------------------------------------------------------- members

      function validMemberShape() {
        let d = request.resource.data;
        return d.keys().hasOnly(['role', 'perms', 'fundIds', 'personIds', 'displayName',
                                 'email', 'status', 'joinedAt', 'inviteCode'])
          && d.role in ['owner', 'admin', 'member']
          && d.perms is list
          && d.perms.hasOnly(['writeTransactions', 'reverseTransactions', 'manageMasterData',
                              'manageMembers', 'approveAdjustments', 'readAll'])
          && d.fundIds is list && d.fundIds.size() <= 100
          && d.personIds is list && d.personIds.size() <= 100
          && d.status in ['active', 'revoked'];
      }

      function ownerUid() {
        return get(householdPath(hid)).data.ownerUid;
      }

      match /members/{uid} {
        allow read: if isMember(hid)
          && (uid == request.auth.uid || can(hid, 'manageMembers') || readsAll(hid));

        allow create: if signedIn() && uid == request.auth.uid && validMemberShape() && (
          // Bootstrap: the creator of a brand-new household becomes owner.
          (!exists(householdPath(hid))
            && getAfter(householdPath(hid)).data.ownerUid == request.auth.uid
            && request.resource.data.role == 'owner'
            && request.resource.data.status == 'active')
          // Joining through a valid invitation, with exactly its grants.
          || acceptsInvite(hid)
        );

        // Owners manage everyone but themselves; admins with manageMembers
        // only manage plain members and cannot grant permissions.
        allow update: if validMemberShape()
          && uid != ownerUid()
          && request.resource.data.role != 'owner'
          && (isOwner(hid)
              || (can(hid, 'manageMembers')
                  && resource.data.role == 'member'
                  && request.resource.data.role == 'member'
                  && request.resource.data.perms.size() == 0));

        // Revocation (or leaving). The owner can never be removed.
        allow delete: if uid != ownerUid() && (
          isOwner(hid)
          || (can(hid, 'manageMembers') && resource.data.role == 'member')
          || uid == request.auth.uid);
      }

      function acceptsInvite(hid) {
        let code = request.resource.data.inviteCode;
        let path = /databases/$(database)/documents/invites/$(code);
        let inv = get(path).data;
        let after = getAfter(path).data;
        return code is string
          && exists(path)
          && inv.householdId == hid
          && inv.usedBy == null
          && inv.expiresAt > request.time
          && request.auth.token.email_verified == true
          && inv.email == request.auth.token.email
          && after.usedBy == request.auth.uid
          && request.resource.data.role == inv.role
          && request.resource.data.perms == inv.perms
          && request.resource.data.fundIds == inv.fundIds
          && request.resource.data.personIds == inv.personIds
          && request.resource.data.status == 'active';
      }

      // --------------------------------------------------------- transactions

      function validTx(txId) {
        let d = request.resource.data;
        return d.id == txId
          && d.status in ['pending', 'posted', 'cancelled']
          && d.type is string
          && d.dateKey is int && d.dateKey >= 19000101 && d.dateKey <= 29991231
          && d.currency == 'BDT'
          && d.totalDebit is int && d.totalCredit is int
          && d.totalDebit == d.totalCredit && d.totalDebit > 0
          && d.lines is list && d.lines.size() >= 2 && d.lines.size() <= 50
          && d.fundIds is list && d.fundIds.size() >= 1
          && d.contentHash is string && d.contentHash.size() == 64
          && d.version is int
          && hasReaders()
          && stampedNow();
      }

      match /transactions/{txId} {
        allow read: if canRead(hid);

        allow create: if can(hid, 'writeTransactions')
          && validTx(txId)
          && (request.resource.data.createdBy == request.auth.uid
              || (isOwner(hid) && request.resource.data.createdBy == 'local-owner'));

        allow update: if can(hid, 'writeTransactions') && validTx(txId) && (
          // A pending entry may be replaced by a newer version of itself.
          (resource.data.status == 'pending'
            && request.resource.data.version > resource.data.version
            && request.resource.data.createdBy == resource.data.createdBy)
          // Otherwise only status / reversal link / readers may change.
          || (request.resource.data.diff(resource.data).affectedKeys()
                .hasOnly(['status', 'reversedByTxId', 'version', 'modifiedBy',
                          'readerUids', 'postedAt', 'updatedAt', 'updatedAtServer'])
              && request.resource.data.version >= resource.data.version
              && (request.resource.data.status == resource.data.status
                  || (resource.data.status == 'pending'
                      && request.resource.data.status in ['posted', 'cancelled']))
              && (request.resource.data.get('reversedByTxId', null) == resource.data.get('reversedByTxId', null)
                  || (resource.data.get('reversedByTxId', null) == null
                      && resource.data.status == 'posted'
                      && can(hid, 'reverseTransactions'))))
        );

        allow delete: if false;
      }

      // ---------------------------------------------------------- master data

      function validEntity(id) {
        return request.resource.data.id == id
          && request.resource.data.version is int
          && (resource == null || request.resource.data.version >= resource.data.version)
          && hasReaders()
          && stampedNow();
      }

      match /persons/{id} {
        allow read: if canRead(hid);
        allow create, update: if can(hid, 'manageMasterData') && validEntity(id);
        allow delete: if false;
      }

      match /funds/{id} {
        allow read: if canRead(hid);
        allow create, update: if can(hid, 'manageMasterData') && validEntity(id)
          && request.resource.data.kind in ['personal', 'entrusted', 'purpose', 'samity'];
        allow delete: if false;
      }

      match /accounts/{id} {
        allow read: if canRead(hid);
        allow create, update: if can(hid, 'manageMasterData') && validEntity(id)
          // Never more than the last four digits of an account number.
          && (request.resource.data.get('numberHint', null) == null
              || request.resource.data.numberHint.size() <= 4);
        allow delete: if false;
      }

      match /samities/{id} {
        allow read: if canRead(hid);
        allow create, update: if can(hid, 'manageMasterData') && validEntity(id);
        allow delete: if false;
      }

      match /budgets/{id} {
        allow read: if canRead(hid);
        allow create, update: if can(hid, 'manageMasterData') && validEntity(id);
        allow delete: if false;
      }

      match /obligations/{id} {
        allow read: if canRead(hid);
        allow create, update: if can(hid, 'writeTransactions') && validEntity(id);
        allow delete: if false;
      }

      match /recon/{id} {
        allow read: if canRead(hid);
        allow create, update: if can(hid, 'writeTransactions') && hasReaders() && stampedNow()
          && request.resource.data.id == id
          // Only approvers may mark an adjustment approved.
          && (request.resource.data.get('approvedBy', null) == null
              || (resource != null
                  && request.resource.data.approvedBy == resource.data.get('approvedBy', null))
              || (request.resource.data.approvedBy == request.auth.uid
                  && can(hid, 'approveAdjustments')));
        allow delete: if false;
      }

      match /audit/{id} {
        allow read: if readsAll(hid);
        allow create: if can(hid, 'writeTransactions')
          && request.resource.data.actorId == request.auth.uid;
        allow update, delete: if false;
      }
    }

    // --------------------------------------------------------------- invites

    match /invites/{code} {
      function validInvite() {
        let d = request.resource.data;
        return d.keys().hasOnly(['householdId', 'email', 'role', 'perms', 'fundIds',
                                 'personIds', 'createdBy', 'createdAt', 'expiresAt',
                                 'usedBy', 'usedAt'])
          && d.email is string && d.email.size() > 3
          && d.role in ['admin', 'member']
          && d.perms is list && d.fundIds is list && d.personIds is list
          && d.createdBy == request.auth.uid
          && d.usedBy == null
          && d.expiresAt is timestamp
          && d.expiresAt > request.time
          && d.expiresAt < request.time + duration.value(15, 'd')
          && code.size() >= 16;
      }

      allow create: if signedIn() && validInvite()
        && can(request.resource.data.householdId, 'manageMembers')
        // Only the owner may invite admins or delegate permissions.
        && (isOwner(request.resource.data.householdId)
            || (request.resource.data.role == 'member' && request.resource.data.perms.size() == 0));

      allow read: if signedIn() && (
        (resource.data.email == request.auth.token.email && request.auth.token.email_verified == true)
        || can(resource.data.householdId, 'manageMembers'));

      // Redeemed once, by the invited (verified) email, while joining.
      allow update: if signedIn()
        && resource.data.usedBy == null
        && resource.data.expiresAt > request.time
        && resource.data.email == request.auth.token.email
        && request.auth.token.email_verified == true
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['usedBy', 'usedAt'])
        && request.resource.data.usedBy == request.auth.uid
        && existsAfter(/databases/$(database)/documents/households/$(resource.data.householdId)/members/$(request.auth.uid));

      allow delete: if signedIn() && can(resource.data.householdId, 'manageMembers');
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
